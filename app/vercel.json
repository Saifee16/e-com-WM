{
  "redirects": [
    {
      "source": "/smartphones",
      "destination": "/phones",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://api.wahabmobiles.com/api/seo/sitemap.xml"
    },

    {
      "source": "/products/:slug",
      "destination": "/api/product-page?slug=:slug"
    },
    {
      "source": "/search",
      "destination": "/api/route-page?route=search"
    },
    {
      "source": "/products",
      "destination": "/api/route-page?route=products"
    },

    {
      "source": "/phones",
      "destination": "/api/route-page?route=category&root=phones&slug=phones"
    },
    {
      "source": "/phones/:categorySlug",
      "destination": "/api/route-page?route=category&root=phones&slug=:categorySlug"
    },
    {
      "source": "/tablets",
      "destination": "/api/route-page?route=category&root=tablets&slug=tablets"
    },

    {
      "source": "/hyderabad",
      "destination": "/api/route-page?route=static&slug=hyderabad"
    },
    {
      "source": "/about",
      "destination": "/api/route-page?route=static&slug=about"
    },
    {
      "source": "/services",
      "destination": "/api/route-page?route=static&slug=services"
