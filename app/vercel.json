    },

    {
      "source": "/smart-watches",
      "destination": "/api/route-page?route=category&root=smart-watches&slug=smart-watches"
    },
    {
      "source": "/smart-watches/:categorySlug",
      "destination": "/api/route-page?route=category&root=smart-watches&slug=:categorySlug"
