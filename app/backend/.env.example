NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:15432/ecommerce_dev?schema=public
REDIS_URL=redis://localhost:16379
JWT_ACCESS_SECRET=GENERATE_A_UNIQUE_64_CHARACTER_RANDOM_VALUE
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_UNIQUE_64_CHARACTER_RANDOM_VALUE
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=localhost
# Local HTTP development uses false/lax. Production HTTPS must use COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
OBJECT_STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
