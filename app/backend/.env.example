NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:15432/ecommerce_dev?schema=public
REDIS_URL=redis://localhost:16379
JWT_ACCESS_SECRET=GENERATE_A_UNIQUE_64_CHARACTER_RANDOM_VALUE
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_UNIQUE_64_CHARACTER_RANDOM_VALUE
# Set to 1 only when the backend is reached through one trusted reverse-proxy hop.
TRUST_PROXY_HOPS=0
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
# Local HTTP development uses false/lax. Production HTTPS must use COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
# Password reset is limited by client IP and separately cooled down per account.
PASSWORD_RESET_IP_MAX=5
PASSWORD_RESET_IP_WINDOW_SECONDS=900
PASSWORD_RESET_ACCOUNT_COOLDOWN_SECONDS=300
PUBLIC_FORM_RATE_LIMIT_MAX=10
PUBLIC_FORM_RATE_LIMIT_WINDOW_SECONDS=900
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Facebook Login (Meta for Developers)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=
# Use the Graph API version selected for the Meta app, for example vXX.X.
FACEBOOK_GRAPH_API_VERSION=
