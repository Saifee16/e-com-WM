# Compose database service (required by docker-compose.yml and docker-compose.prod.yml)
POSTGRES_USER=REPLACE_WITH_A_NONDEFAULT_DATABASE_USER
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=ecommerce

# Public deployment origin. Production Compose serves the Vite build and proxies /api at this origin.
FRONTEND_URL=https://shop.example.com
VITE_API_BASE_URL=/api

# Backend runtime configuration used by docker-compose.prod.yml
NODE_ENV=production
PORT=4000
API_BASE_URL=https://shop.example.com
# Use the Compose Postgres hostname, not localhost, from the backend container.
DATABASE_URL=postgresql://REPLACE_WITH_A_NONDEFAULT_DATABASE_USER:REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/ecommerce?schema=public
# Redis is internal-only in the production Compose network; change this only for an external Redis service.
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=GENERATE_A_UNIQUE_64_CHARACTER_RANDOM_VALUE
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_UNIQUE_64_CHARACTER_RANDOM_VALUE
# The backend is behind the single Nginx proxy service in docker-compose.prod.yml.
TRUST_PROXY_HOPS=1
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
PASSWORD_RESET_IP_MAX=5
PASSWORD_RESET_IP_WINDOW_SECONDS=900
PASSWORD_RESET_ACCOUNT_COOLDOWN_SECONDS=300
PUBLIC_FORM_RATE_LIMIT_MAX=10
PUBLIC_FORM_RATE_LIMIT_WINDOW_SECONDS=900
EMAIL_FROM=no-reply@example.com
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://shop.example.com/auth/google/callback

# Facebook Login (Meta for Developers)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://shop.example.com/auth/facebook/callback
# Use the Graph API version selected for the Meta app, for example vXX.X.
FACEBOOK_GRAPH_API_VERSION=

# Product image storage. Production defaults to Cloudinary; direct local development can use PRODUCT_IMAGE_STORAGE=local.
PRODUCT_IMAGE_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=wahab-mobiles/products

# Host port for the frontend reverse proxy. Postgres and Redis are intentionally not exposed in production.
FRONTEND_PORT=8080
